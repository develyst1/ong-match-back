    "db:seed": "bun run src/db/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
