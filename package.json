{
  "name": "ong-match-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/ong-match-back",
    "start": "bun run src/index.ts",
    "migrate": "bun run src/db/migrate.ts",
